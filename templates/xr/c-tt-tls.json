        {
          "tag": "trojan-tls",
          "listen": "::",
          "port": __PORT__,
          "protocol": "trojan",
          "settings": {
            "users": [{ "password": "__UUID__" }]
          },
          "streamSettings": {
            "network": "tcp",
            "security": "tls",
            "tlsSettings": {
              "certificates": [{
                "certificateFile": "/etc/argosbx/certs/directnym.crt",
                "keyFile": "/etc/argosbx/certs/directnym.key"
              }],
              "alpn": ["http/1.1"]
            }
          },
          "sniffing": {
            "enabled": true,
            "destOverride": ["http", "tls", "quic"],
            "metadataOnly": false
          }
        }
