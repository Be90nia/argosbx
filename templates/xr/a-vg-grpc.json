    {
      "tag":"vless-grpc",
      "listen": "@vless-grpc",
      "protocol": "vless",
      "settings": {
        "users": [
          {
            "id": "__UUID__"
          }
        ],
        "decryption": "__DEKEY__"
      },
      "streamSettings": {
        "network": "grpc",
        "security": "none",
        "grpcSettings": {
          "serviceName": "__BASEPATH__-vg",
          "multiMode": true
        }
      },
        "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "metadataOnly": false
      }
    }
